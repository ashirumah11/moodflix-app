# ─── MoodFlix Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django core
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── TMDB API Credentials ──────────────────────────────────────────────────────
# Sign up free at https://www.themoviedb.org/settings/api
# Providing both is recommended — Bearer token takes priority; API key is fallback.

# TMDB v3 API Key  (Settings → API → API Key)
TMDB_API_KEY=

# TMDB v4 Read Access Token  (Settings → API → API Read Access Token)
TMDB_READ_ACCESS_TOKEN=

# Cache timeout in seconds (default: 1 hour)
TMDB_CACHE_TIMEOUT=3600

# ─── Optional: PostgreSQL for production ───────────────────────────────────────
# Uncomment and fill in when deploying to production.
# DATABASE_URL=postgres://user:password@localhost:5432/moodflix
